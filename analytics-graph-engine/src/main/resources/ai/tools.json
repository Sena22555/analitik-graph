      },
      "description": "Колонки строк (0–2)"
     },
     "columns": {
      "type": "string"
     },
     "values": {
      "type": "string"
     },
     "agg": {
      "type": "string",
      "description": "rate = доля строк со значением > 0 (напр. доля купивших)",
      "enum": [
       "count",
       "share",
       "sum",
       "mean",
       "median",
       "min",
       "max",
       "rate",
       "distinct"
      ]
     },
     "filters": {
      "$ref": "#/filters"
     },
     "title": {
      "type": "string"
     },
     "top": {
      "type": "integer"
     }
    },
    "required": [
     "agg"
    ]
   }
  }
 },
