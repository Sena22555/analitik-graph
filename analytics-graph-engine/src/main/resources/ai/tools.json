 },
 {
  "type": "function",
  "function": {
   "name": "pivot_table",
   "description": "Сводная таблица: группировка по 1–2 измерениям (rows), разбивка по столбцам (columns), агрегат по values. Числовые измерения режутся на квартили. Пользователь получает таблицу с экспортом в Excel.",
   "parameters": {
    "type": "object",
    "properties": {
