 {
  "type": "function",
  "function": {
   "name": "create_presentation",
   "description": "Презентация. Сервер сам считает все графики/таблицы/KPI по спецификациям и генерирует изображения по image_prompt. Пользователь получает слайды с экспортом в PowerPoint и PDF.",
   "parameters": {
    "type": "object",
    "properties": {
     "title": {
      "type": "string"
     },
     "subtitle": {
      "type": "string"
     },
     "theme": {
      "type": "string",
      "description": "executive — совет директоров; ledger — финансы/бухгалтерия; editorial — аналитическая записка/сторителлинг; midnight — тёмная, для демо; bold — маркетинг/продукт; minimal — швейцарский минимализм",
      "enum": [
       "executive",
       "ledger",
       "editorial",
       "midnight",
       "bold",
       "minimal"
      ]
     },
     "slides": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "layout": {
         "type": "string",
         "description": "title — обложка; agenda — план; section — раздел; bullets — тезисы; kpis — 2–4 карточки; big_number — одна ключевая цифра (kpis[0]); chart — график+выводы; table — таблица+выводы; comparison — два столбца left/right; quote — главный вывод крупно (subtitle); timeline — шаги (bullets); image — иллюстрация+текст; recommendations — действия; closing — итог",
         "enum": [
          "title",
          "agenda",
          "section",
          "bullets",
          "kpis",
          "big_number",
          "chart",
          "table",
          "comparison",
          "quote",
          "timeline",
          "image",
          "recommendations",
          "closing"
         ]
        },
        "title": {
         "type": "string",
         "description": "Заголовок-вывод, а не тема"
        },
        "subtitle": {
         "type": "string"
        },
        "bullets": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "kpis": {
         "type": "array",
         "items": {
          "type": "object",
          "properties": {
           "label": {
            "type": "string"
           },
           "value": {
            "type": "string",
            "description": "Готовое значение, если уже посчитано инструментом"
           },
           "column": {
            "type": "string"
           },
           "agg": {
            "type": "string",
            "enum": [
             "count",
             "share",
             "sum",
             "mean",
             "median",
             "min",
             "max",
             "rate"
            ]
           },
           "filters": {
            "$ref": "#/filters"
           },
           "note": {
            "type": "string",
            "description": "Пояснение/динамика, напр. «+12% к прошлому месяцу»"
           }
          },
          "required": [
           "label"
          ]
         }
        },
        "chart": {
         "type": "object",
         "properties": {
          "type": {
           "type": "string",
           "enum": [
            "bar",
            "line",
            "pie",
            "histogram",
            "scatter"
           ]
          },
          "x": {
           "type": "string"
          },
          "y": {
           "type": "string"
          },
          "agg": {
           "type": "string",
           "enum": [
            "count",
            "share",
            "sum",
            "mean",
            "median",
            "min",
            "max",
            "rate"
           ]
          },
          "group": {
           "type": "string"
          },
          "title": {
           "type": "string"
          },
          "filters": {
           "$ref": "#/filters"
          },
          "top": {
           "type": "integer"
          }
         }
        },
        "table": {
         "type": "object",
         "properties": {
          "kind": {
           "type": "string",
           "description": "pivot | compare | funnel | drivers | abc | trend | finance | quality | anomalies",
           "enum": [
            "pivot",
            "compare",
            "funnel",
            "drivers",
            "abc",
            "trend",
            "finance",
            "quality",
            "anomalies"
           ]
          },
          "rows": {
           "type": "array",
           "items": {
            "type": "string"
           }
          },
          "columns": {
           "type": "string"
          },
          "values": {
           "type": "string"
          },
          "agg": {
           "type": "string"
          },
          "metric": {
           "type": "string"
          },
          "group_by": {
           "type": "string"
          },
          "by": {
           "type": "string"
          },
          "target": {
           "type": "string"
          },
          "dim": {
           "type": "string"
          },
          "value": {
           "type": "string"
          },
          "filters": {
           "$ref": "#/filters"
          },
          "top": {
           "type": "integer"
          },
          "title": {
           "type": "string"
          }
         }
        },
        "left": {
         "type": "object",
         "properties": {
          "title": {
           "type": "string"
          },
          "value": {
           "type": "string"
          },
          "bullets": {
           "type": "array",
           "items": {
            "type": "string"
           }
          }
         }
        },
        "right": {
         "type": "object",
         "properties": {
          "title": {
           "type": "string"
          },
          "value": {
           "type": "string"
          },
          "bullets": {
           "type": "array",
           "items": {
            "type": "string"
           }
          }
         }
        },
        "image_prompt": {
         "type": "string",
         "description": "Если нужна иллюстрация: описание на английском, без текста на изображении"
        },
        "notes": {
         "type": "string",
         "description": "Заметки докладчика"
        }
       },
       "required": [
        "layout",
        "title"
       ]
      }
     }
    },
    "required": [
     "title",
     "slides"
